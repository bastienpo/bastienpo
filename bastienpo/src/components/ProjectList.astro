---
import { getCollection } from "astro:content";
import { shellClass } from "../data/site";
import ProjectCard from "./ProjectCard.astro";
import SectionLabel from "./SectionLabel.astro";

const projects = (await getCollection("projects")).sort(
	(a, b) => a.data.order - b.data.order,
);
---

<section aria-labelledby="projects" class:list={[shellClass, "flex flex-col gap-12 py-16"]}>
	<SectionLabel id="projects">Projects</SectionLabel>
	<div class="flex flex-col gap-8">
		{projects.map((project) => <ProjectCard project={project} />)}
	</div>
</section>
