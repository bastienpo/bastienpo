---
import { Icon } from "astro-icon/components";
import { Link } from "accessible-astro-components";
---

<header class="px-6 py-4" style="padding: 0 var(--pad) 84px;">
  <nav class="flex items-center justify-between" aria-label="Principale">
    <Link href="/" class="no-underline font-bold">
      <h1 class="text-2xl">bastienpo</h1>
    </Link>
    <div class="flex items-center gap-6" aria-label="socials">
      <Link href="https://github.com/bastienpo" isExternal hideIcon ariaLabel="GitHub">
        <Icon name="tabler:brand-github" size={24} aria-hidden="true" />
      </Link>
      <Link href="https://x.com/po_bastien" isExternal hideIcon ariaLabel="X">
        <Icon name="tabler:brand-x" size={24} aria-hidden="true" />
      </Link>
    </div>
  </nav>
</header>
