---
import { Picture } from "astro:assets";
import type { CollectionEntry } from "astro:content";

interface Props {
    project: CollectionEntry<"projects">;
}

const { project } = Astro.props;
---

<article
    class="overflow-hidden rounded-md bg-background shadow-[0_1px_2px_#00000014,0_12px_32px_#0000001F]"
>
    <a
        href={project.data.href}
        rel="noopener noreferrer"
        target="_blank"
        class="flex flex-col focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-foreground lg:flex-row lg:items-stretch"
    >
        <Picture
            src={project.data.image}
            alt={project.data.imageAlt}
            formats={["avif", "webp"]}
            widths={[326, 560, 800]}
            sizes="(min-width: 1024px) 280px, min(800px, calc(100vw - 64px))"
            width={800}
            height={560}
            class="h-50 w-full bg-foreground object-cover lg:h-50 lg:w-70 lg:shrink-0"
        />
        <div class="flex min-w-0 flex-1 flex-col justify-center gap-3 p-6">
            <h3 class="text-xl leading-7 font-semibold text-foreground">
                {project.data.title}
            </h3>
            <p class="flex items-start gap-4 text-base leading-6 text-muted">
                <span class="min-w-0 flex-1">{project.data.description}</span>
                <span class="shrink-0 text-subtle" aria-hidden="true">&gt;</span
                >
            </p>
            <span class="sr-only"> (opens in a new tab)</span>
        </div>
    </a>
</article>
