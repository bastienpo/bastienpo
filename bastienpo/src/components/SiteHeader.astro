---
import { Picture } from "astro:assets";
import logo from "../assets/logo.png";
import { shellClass, site } from "../data/site";
---

<header>
    <div
        class:list={[
            shellClass,
            "flex items-center justify-between py-6 lg:py-8",
        ]}
    >
        <a href="/" class="flex items-center gap-2.5">
            <Picture
                src={logo}
                alt=""
                loading="eager"
                width={64}
                height={64}
                class="rounded-md object-cover"
            />
            <h1 class="hidden text-lg leading-7 tracking-wider lg:inline">
                {site.name}
            </h1>
        </a>

        <nav class="hidden lg:block" aria-label="Primary">
            <ul class="flex items-center gap-8">
                {
                    site.nav.map((item) => (
                        <li>
                            <a
                                href={item.href}
                                class="text-base leading-6 text-muted transition-colors hover:text-foreground focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-foreground"
                            >
                                {item.label}
                            </a>
                        </li>
                    ))
                }
            </ul>
        </nav>

        <button
            id="menu-open"
            type="button"
            class="inline-flex size-10 items-center justify-center rounded-md text-foreground lg:hidden focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-foreground"
            aria-expanded="false"
            aria-controls="mobile-menu"
            aria-haspopup="dialog"
        >
            <span class="sr-only">Open menu</span>
            <svg
                xmlns="http://www.w3.org/2000/svg"
                width="20"
                height="20"
                viewBox="0 0 20 20"
                fill="none"
                aria-hidden="true"
            >
                <path
                    d="M3 5.5h14M3 10h14M3 14.5h14"
                    stroke="currentColor"
                    stroke-width="1.5"
                    stroke-linecap="round"></path>
            </svg>
        </button>
    </div>

    <div class={shellClass} aria-hidden="true">
        <div class="h-px bg-border"></div>
    </div>
</header>

<dialog
    id="mobile-menu"
    class="m-0 h-full max-h-none w-full max-w-none bg-background p-0 text-foreground backdrop:bg-background"
    aria-labelledby="mobile-menu-title"
>
    <div class:list={[shellClass, "flex items-center justify-between py-6"]}>
        <a
            href="/"
            class="flex items-center rounded-md focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-foreground"
            data-close-menu
        >
            <Picture
                src={logo}
                alt=""
                formats={["avif", "webp"]}
                width={64}
                height={64}
                densities={[1, 2]}
                class="size-8 rounded-md bg-foreground object-cover"
            />
            <span class="sr-only">{site.name} home</span>
        </a>
        <p id="mobile-menu-title" class="sr-only">Site menu</p>
        <button
            type="button"
            data-close-menu
            class="inline-flex size-10 items-center justify-center rounded-md text-foreground focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-foreground"
        >
            <span class="sr-only">Close menu</span>
            <svg
                xmlns="http://www.w3.org/2000/svg"
                width="18"
                height="18"
                viewBox="0 0 18 18"
                fill="none"
                aria-hidden="true"
            >
                <path
                    d="M4 4l10 10M14 4L4 14"
                    stroke="currentColor"
                    stroke-width="1.5"
                    stroke-linecap="round"></path>
            </svg>
        </button>
    </div>
    <div class={shellClass} aria-hidden="true">
        <div class="h-px bg-border"></div>
    </div>
    <nav
        aria-label="Mobile"
        class:list={[shellClass, "flex flex-col items-end gap-8 py-16"]}
    >
        {
            site.nav.map((item) => (
                <a
                    href={item.href}
                    data-close-menu
                    class="text-2xl leading-8 text-muted hover:text-foreground focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-foreground"
                >
                    {item.label}
                </a>
            ))
        }
    </nav>
</dialog>

<script>
    const dialog = document.getElementById("mobile-menu");
    const openButton = document.getElementById("menu-open");

    if (
        dialog instanceof HTMLDialogElement &&
        openButton instanceof HTMLButtonElement
    ) {
        const setExpanded = (open: boolean) => {
            openButton.setAttribute("aria-expanded", String(open));
        };

        openButton.addEventListener("click", () => {
            dialog.showModal();
            setExpanded(true);
        });

        dialog.addEventListener("close", () => {
            setExpanded(false);
            openButton.focus();
        });

        dialog.querySelectorAll("[data-close-menu]").forEach((el) => {
            el.addEventListener("click", () => {
                dialog.close();
            });
        });
    }
</script>
