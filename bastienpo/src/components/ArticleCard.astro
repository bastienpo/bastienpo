---
import type { CollectionEntry } from "astro:content";
import { formatDate } from "../data/site";

interface Props {
	article: CollectionEntry<"articles">;
}

const { article } = Astro.props;
const href = `/articles/${article.id}`;
---

<article>
	<a
		href={href}
		class="group block rounded-md focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-foreground"
	>
		<h3 class="text-2xl leading-8 font-semibold text-foreground">
			{article.data.title}
		</h3>
		<p class="mt-3 text-base leading-6 text-muted">
			{article.data.description}
		</p>
		<p class="mt-4 flex items-center gap-3 text-sm leading-5 text-muted">
			<time datetime={article.data.pubDate.toISOString()}>
				{formatDate(article.data.pubDate)}
			</time>
			<span>
				{article.data.tags.map((tag) => `#${tag}`).join(" ")}
			</span>
			<span class="ms-auto text-subtle" aria-hidden="true">&gt;</span>
		</p>
	</a>
</article>
